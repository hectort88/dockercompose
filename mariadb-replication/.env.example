# MariaDB Master and Replica Configuration

# Root password for all MariaDB instances
MYSQL_ROOT_PASSWORD=rootpassword

# Default database to create
MYSQL_DATABASE=mydb

# Application user credentials
MYSQL_USER=user
MYSQL_PASSWORD=userpassword

# Replication user credentials
MYSQL_REPLICATION_USER=repl_user
MYSQL_REPLICATION_PASSWORD=repl_password

# Port mappings (host:container)
MARIADB_MASTER_PORT=3306
MARIADB_REPLICA1_PORT=3307
MARIADB_REPLICA2_PORT=3308

# Server IDs (must be unique for each instance)
MARIADB_MASTER_SERVER_ID=1
MARIADB_REPLICA1_SERVER_ID=2
MARIADB_REPLICA2_SERVER_ID=3
